#!/usr/bin/env bash
# numbrone — a chief-of-staff workflow on top of herdr.
#
#   chief (you talk to it)  ──delegate──▶  manager-<project>  ──spawn──▶  worker-<task>
#        ▲                                      │  ▲                      │
#        └────────────── report ────────────────┘  └──────── report ─────┘
#
# Everything is plain files in the numbrone home folder (the parent of this script's bin/):
#   projects.json          project index: { "<name>": { "path": ..., "summary": ... } }
#   projects/<name>/       context.md for each project
#   tasks/<task>.md        brief + status + append-only log, one file per task
#   notes/<task>.md        what a worker delivered that isn't a change to a project
#   roles/                 instructions for managers, workers and the dreamer
#   projects/<name>/lessons.md  what the dreams learned about working in that project
#   log/<date>.md          the daily work log: outcomes and decisions (details stay in tasks/)
#   log/dreams/<date>.md   the daily dream: what the logs say, what changed, what to try next
#   knowledge/             what the chief has learned about the user's world, by topic
#   (workers' git worktrees live in each project, under .numbrone/worktrees/)
#   settings.sh            which agent to run, and with which arguments
set -euo pipefail

NUMBRONE_HOME="${NUMBRONE_HOME:-$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)}"
STATUSES="queued working blocked review done closed"

usage() {
  cat <<'EOF'
numbrone — chief-of-staff workflow on herdr

Setup
  numbrone init <folder>                         create (or upgrade) a numbrone home folder
  numbrone add <name> <path> "<summary>"         register a project
  numbrone remove <name>                         unregister a project
  numbrone projects                              list registered projects
  numbrone up [name]                             start a herdr workspace + manager for each project
  numbrone chief                                 mark the current agent as the chief, then show status

Work
  numbrone delegate <project> <task> "<brief>" [kind]
                                                 chief → manager: create a task and hand it over.
                                                 kind is one word for the kind of work (code, research,
                                                 writing, email, ...), so stats and dreams can compare kinds
                                                 (a manager can also use it to create its own tasks)
  numbrone spawn <task>                          manager → worker: worktree + tab + agent for a task
  numbrone report <task> <status> "<note>"       log progress and ping whoever is one level up
                                                 status: working | blocked | review | done
  numbrone status [task]                         overview of all open tasks, or one task's file
  numbrone send-back <task> "<what to fix>"      send work back one level down, and record it
  numbrone close <task> <verdict> ["<note>"]     record the user's verdict (accepted | changed | dropped)
                                                 and, for code, close the worker tab and remove its worktree
                                                 (keeps the branch). changed and dropped need a note
  numbrone log ["<note>" | <date>]               add a note to today's work log, or print a day's log

Learning
  numbrone stats [days]                          per-task numbers for the last N days (default 7)
  numbrone dream [--force]                       start the daily dream, unless today's already ran
  numbrone dream done "<summary>"                the dreamer reports that it has finished
EOF
}

# ── helpers ────────────────────────────────────────────────────────────────

die() { echo "numbrone: $*" >&2; exit 1; }
now() { date '+%Y-%m-%d %H:%M'; }

# Names become herdr agent names, which must match [a-z][a-z0-9_-]{0,31}.
check_name() { # <value> <maximum length>
  [[ "$1" =~ ^[a-z][a-z0-9-]*$ && ${#1} -le $2 ]] ||
    die "'$1' must be lowercase letters, digits and dashes, start with a letter, at most $2 characters"
}

load() {
  [ -f "$NUMBRONE_HOME/projects.json" ] || die "no numbrone home found at $NUMBRONE_HOME (run: numbrone init <folder>)"
  command -v jq >/dev/null || die "jq is required"
  AGENT_KIND=claude AGENT_ARGUMENTS="" BASE_BRANCH="" PING_CHIEF=1 DREAM_HOUR=3
  # shellcheck source=/dev/null
  [ -f "$NUMBRONE_HOME/settings.sh" ] && . "$NUMBRONE_HOME/settings.sh"
  return 0
}

# Dates in task files are "YYYY-MM-DD HH:MM". BSD date (macOS) first, then GNU date (Linux).
epoch()    { date -j -f '%Y-%m-%d %H:%M:%S' "$1:00" +%s 2>/dev/null || date -d "$1" +%s; }
days_ago() { date -v-"$1"d +%F 2>/dev/null || date -d "$1 days ago" +%F; }
duration() { # <seconds> → 45m, 3h10m, 2d4h
  local minutes=$(( $1 / 60 ))
  if   [ "$minutes" -lt 60 ];   then echo "${minutes}m"
  elif [ "$minutes" -lt 1440 ]; then printf '%dh%02dm\n' $(( minutes / 60 )) $(( minutes % 60 ))
  else echo "$(( minutes / 1440 ))d$(( minutes % 1440 / 60 ))h"; fi
}

project_path() { jq -r --arg name "$1" '.[$name].path // empty' "$NUMBRONE_HOME/projects.json"; }
task_file()    { echo "$NUMBRONE_HOME/tasks/$1.md"; }
field()        { sed -n "s/^$2: //p" "$1" | head -n1; }                # <file> <key>
set_field()    { sed -i.backup "s|^$2:.*|$2: $3|" "$1" && rm -f "$1.backup"; } # <file> <key> <value>
task_log()     { echo "- $(now) [$2] $3" >> "$1"; }                     # <task file> <who> <text>
log_line()     { task_log "$@"; journal "$2" "$(basename "$1" .md): $3"; } # same, and into the work log

# The work log: one Markdown file per day in log/. It records outcomes and decisions only:
# tasks queued, blocked, delivered and closed, plus notes added with `numbrone log`.
# Step-by-step progress stays in each task file. Nothing is ever rewritten, so it's an audit trail.
journal() { # <who> <text>
  local log_file; log_file="$NUMBRONE_HOME/log/$(date +%F).md"
  mkdir -p "$NUMBRONE_HOME/log"
  [ -f "$log_file" ] || printf '# Work log %s\n\n' "$(date +%F)" > "$log_file"
  echo "- $(date +%H:%M) [$1] $2" >> "$log_file"
}

workspace_id() { # herdr workspace labelled numbrone/<project>
  herdr workspace list |
    jq -r --arg label "numbrone/$1" '.result.workspaces[] | select(.label == $label) | .workspace_id' | head -n1
}
agent_state() { # prints idle|working|blocked|done|unknown, or "-" if no such agent
  herdr agent get "$1" 2>/dev/null | jq -r '.result.agent.agent_status' || echo "-"
}
my_name() { # the herdr agent name of whoever is calling numbrone
  [ -n "${HERDR_PANE_ID:-}" ] || { echo "shell"; return; }
  herdr agent list |
    jq -r --arg pane "$HERDR_PANE_ID" '[.result.agents[] | select(.pane_id == $pane) | .name // empty][0] // "shell"'
}

start_agent() { # <name> <pane> <first prompt>
  local agent_arguments=()
  [ -n "$AGENT_ARGUMENTS" ] && read -r -a agent_arguments <<< "$AGENT_ARGUMENTS"
  if ! herdr agent start "$1" --kind "$AGENT_KIND" --pane "$2" --timeout 120000 -- ${agent_arguments[@]+"${agent_arguments[@]}"} >/dev/null 2>&1; then
    [ "$(agent_state "$1")" = blocked ] || die "could not start $1 (see: herdr pane read $2)"
    # Usually a first-run question such as "Do you trust this folder?". Only a human should answer it.
    echo "numbrone: $1 is waiting at a startup prompt (for example 'trust this folder'). Answer it in herdr; waiting up to 5 minutes..." >&2
    herdr notification show "$1 needs you" --body "Answer its startup prompt in herdr" --sound request >/dev/null 2>&1 || true
    herdr agent wait "$1" --until idle --until done --timeout 300000 >/dev/null || die "$1 is still not ready"
  fi
  # Wait until the agent actually starts working. Right after startup a terminal interface can drop
  # the Enter key and leave the prompt unsent in its input box; one more Enter fixes it.
  herdr agent prompt "$1" "$3" --wait --until working --until blocked --timeout 30000 >/dev/null 2>&1 ||
    herdr agent send-keys "$1" enter >/dev/null
}

# ── setup ──────────────────────────────────────────────────────────────────

command_init() {
  [ $# -eq 1 ] || die "usage: numbrone init <folder>"
  local skill_folder home
  skill_folder="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"   # the skill directory
  mkdir -p "$1"; home="$(cd "$1" && pwd)"
  mkdir -p "$home"/{bin,roles,tasks,notes,projects,log,knowledge}

  cp "$skill_folder/scripts/numbrone" "$home/bin/numbrone" && chmod +x "$home/bin/numbrone"
  # Everything below is yours to edit (retros improve it over time), so it is only
  # written the first time. Delete a file and re-run init to get a fresh copy.
  for file in roles/manager.md roles/worker.md roles/dream.md CLAUDE.md; do
    [ -f "$home/$file" ] || sed "s|{{NUMBRONE_HOME}}|$home|g" "$skill_folder/templates/$(basename "$file")" > "$home/$file"
  done
  [ -e "$home/AGENTS.md" ] || ln -s CLAUDE.md "$home/AGENTS.md"
  [ -f "$home/settings.sh" ] || cp "$skill_folder/templates/settings.sh" "$home/settings.sh"
  [ -f "$home/projects.json" ] || echo '{}' > "$home/projects.json"
  [ -f "$home/knowledge/index.md" ] || cp "$skill_folder/templates/knowledge-index.md" "$home/knowledge/index.md"
  mkdir -p "$home/log/dreams"
  echo "numbrone home ready at $home"
  # Older homes keep their edited CLAUDE.md, so say what dreaming needs from it.
  grep -q "numbrone dream" "$home/CLAUDE.md" ||
    echo "note: to turn on daily dreams, add to the chief's session start in $home/CLAUDE.md: run \`numbrone dream\` every hour with your agent's loop feature"
  grep -q "verdict" "$home/CLAUDE.md" ||
    echo "note: $home/CLAUDE.md predates verdicts; have the chief close every task, of any kind, with \`numbrone close <task> <accepted|changed|dropped> \"<note>\"\` and pass a kind to \`numbrone delegate\`"
  grep -q "send-back" "$home/roles/manager.md" ||
    echo "note: $home/roles/manager.md predates send-back; have managers send work back with \`numbrone send-back <task> \"<what to fix>\"\` so rework is recorded"
}

command_add() {
  [ $# -eq 3 ] || die 'usage: numbrone add <name> <path> "<summary>"'
  load; check_name "$1" 24
  local root temporary_file
  root="$(git -C "$2" rev-parse --show-toplevel 2>/dev/null)" || die "$2 is not a git repository"
  temporary_file="$(mktemp)"
  jq --arg name "$1" --arg path "$root" --arg summary "$3" '.[$name] = {path: $path, summary: $summary}' \
    "$NUMBRONE_HOME/projects.json" > "$temporary_file" && mv "$temporary_file" "$NUMBRONE_HOME/projects.json"
  mkdir -p "$NUMBRONE_HOME/projects/$1"
  echo "added $1 → $root"
}

command_remove() {
  [ $# -eq 1 ] || die "usage: numbrone remove <name>"
  load
  local temporary_file; temporary_file="$(mktemp)"
  jq --arg name "$1" 'del(.[$name])' "$NUMBRONE_HOME/projects.json" > "$temporary_file" && mv "$temporary_file" "$NUMBRONE_HOME/projects.json"
  echo "removed $1 (its workspace and context files were left alone)"
}

command_projects() {
  load
  jq -r 'to_entries[] | "\(.key)\t\(.value.path)\t\(.value.summary)"' "$NUMBRONE_HOME/projects.json" |
    while IFS=$'\t' read -r name path summary; do
      printf '%-20s %-8s %s\n    %s\n' "$name" "$(agent_state "manager-$name")" "$summary" "$path"
    done
}

command_up() {
  load
  local names name path workspace pane
  names="${1:-$(jq -r 'keys[]' "$NUMBRONE_HOME/projects.json")}"
  for name in $names; do
    path="$(project_path "$name")"; [ -n "$path" ] || die "unknown project: $name"
    if [ "$(agent_state "manager-$name")" != "-" ]; then echo "$name: manager already running"; continue; fi

    workspace="$(workspace_id "$name")"
    if [ -z "$workspace" ]; then
      pane="$(herdr workspace create --cwd "$path" --label "numbrone/$name" --no-focus | jq -r '.result.root_pane.pane_id')"
    else
      pane="$(herdr tab create --workspace "$workspace" --cwd "$path" --label manager --no-focus | jq -r '.result.root_pane.pane_id')"
    fi
    start_agent "manager-$name" "$pane" \
      "You are the manager for project '$name'. Read $NUMBRONE_HOME/roles/manager.md and $NUMBRONE_HOME/projects/$name/context.md$(lessons_note "$name"), start any watches listed there, then reply 'ready'."
    echo "$name: started manager-$name"
  done
}

lessons_note() { # <project> → ", and <lessons files>" for whichever the dreams have written
  local file files=""
  for file in "$NUMBRONE_HOME/lessons.md" "$NUMBRONE_HOME/projects/$1/lessons.md"; do
    [ -f "$file" ] && files="$files${files:+ and }$file"
  done
  [ -n "$files" ] && echo ", and $files (lessons from past work)"
  return 0
}

command_chief() {
  [ -n "${HERDR_PANE_ID:-}" ] || die "run this from the chief's agent inside herdr"
  herdr agent rename "$HERDR_PANE_ID" chief >/dev/null
  echo "this agent is now 'chief'"
  command_status
}

# ── work ───────────────────────────────────────────────────────────────────

command_delegate() {
  [ $# -eq 3 ] || [ $# -eq 4 ] || die 'usage: numbrone delegate <project> <task> "<brief>" [kind]'
  load; check_name "$2" 24
  local project="$1" task="$2" brief="$3" kind="${4:-}" file
  [ -z "$kind" ] || check_name "$kind" 16
  [ -n "$(project_path "$project")" ] || die "unknown project: $project"
  file="$(task_file "$task")"
  [ -e "$file" ] && die "task '$task' already exists: $file"

  cat > "$file" <<EOF
# $task
project: $project
kind: $kind
status: queued
branch:
start:
worktree:
created: $(now)

## Brief
$brief

## Log
EOF
  log_line "$file" "$(my_name)" "queued for $project"

  # A manager creating a task for itself (for example from a watched source) needs no message.
  if [ "$(my_name)" = "manager-$project" ]; then echo "created $task; start it now (for example numbrone spawn $task)"; return; fi

  [ "$(agent_state "manager-$project")" != "-" ] || command_up "$project"
  herdr agent prompt "manager-$project" "New task '$task'. Brief: $file" >/dev/null ||
    die "task saved, but manager-$project did not accept the message (blocked?). See: herdr agent read manager-$project"
  echo "delegated $task → manager-$project"
}

command_spawn() {
  [ $# -eq 1 ] || die "usage: numbrone spawn <task>"
  load
  local task="$1" file project path workspace worktree branch pane
  file="$(task_file "$task")"; [ -f "$file" ] || die "no such task: $task"
  project="$(field "$file" project)"; path="$(project_path "$project")"
  [ "$(agent_state "worker-$task")" = "-" ] || die "worker-$task is already running"

  # 1. A git worktree on its own branch, so workers never collide. It lives in
  #    <project>/.numbrone/worktrees/ (hidden via .git/info/exclude, never committed) so the
  #    agent inherits whatever folder trust the user already gave the project.
  worktree="$path/.numbrone/worktrees/$task"; branch="numbrone/$task"
  if [ ! -d "$worktree" ]; then
    local exclude; exclude="$(git -C "$path" rev-parse --path-format=absolute --git-common-dir)/info/exclude"
    grep -qx '.numbrone/worktrees/' "$exclude" 2>/dev/null || { mkdir -p "$(dirname "$exclude")"; echo '.numbrone/worktrees/' >> "$exclude"; }
    if git -C "$path" show-ref --verify --quiet "refs/heads/$branch"; then
      git -C "$path" worktree add -q "$worktree" "$branch"
    else
      git -C "$path" worktree add -q -b "$branch" "$worktree" ${BASE_BRANCH:+"$BASE_BRANCH"}
    fi
  fi

  # 2. A tab in the project's workspace, rooted in that worktree.
  workspace="$(workspace_id "$project")"; [ -n "$workspace" ] || die "no workspace for $project (run: numbrone up $project)"
  pane="$(herdr tab create --workspace "$workspace" --cwd "$worktree" --label "$task" --no-focus | jq -r '.result.root_pane.pane_id')"

  # 3. A worker agent that reads its brief. The task file is updated only once it started.
  if ! (start_agent "worker-$task" "$pane" \
      "You are worker-$task. Read $NUMBRONE_HOME/roles/worker.md$(lessons_note "$project"), then your brief at $file, and start."); then
    herdr tab close "$(herdr pane get "$pane" | jq -r '.result.pane.tab_id')" >/dev/null 2>&1 || true
    exit 1
  fi
  set_field "$file" status working
  set_field "$file" branch "$branch"
  set_field "$file" start "$(git -C "$path" rev-parse "$branch")"   # what the work started from, for stats
  set_field "$file" worktree "$worktree"
  task_log "$file" "$(my_name)" "spawned worker-$task on $branch"
  echo "spawned worker-$task in $worktree"
}

command_report() {
  [ $# -eq 3 ] || die 'usage: numbrone report <task> <status> "<note>"'
  load
  local task="$1" status="$2" note="$3" file who up=""
  file="$(task_file "$task")"; [ -f "$file" ] || die "no such task: $task"
  [[ " $STATUSES " == *" $status "* ]] || die "status must be one of: $STATUSES"
  who="$(my_name)"

  set_field "$file" status "$status"
  # Workers report to their manager, and the manager's report is the one that counts, so only
  # managers' and the chief's status changes go into the work log. Everything stays in the task file.
  if [[ "$who" == worker-* || "$status" == working ]]; then task_log "$file" "$who" "$status: $note"
  else log_line "$file" "$who" "$status: $note"; fi

  # Ping one level up: worker → its manager, manager → chief.
  case "$who" in
    worker-*)  up="manager-$(field "$file" project)" ;;
    manager-*) [ "$PING_CHIEF" = 1 ] && up="chief" ;;
  esac
  if [ -n "$up" ] && [[ "$status" =~ ^(blocked|review|done)$ ]]; then
    herdr agent prompt "$up" "[numbrone] $task is $status ($who): $note" >/dev/null 2>&1 || true
  fi
  if [[ "$status" =~ ^(blocked|review|done)$ ]]; then
    herdr notification show "$task: $status" --body "$note" \
      --sound "$([ "$status" = blocked ] && echo request || echo done)" >/dev/null 2>&1 || true
  fi
  echo "reported $task: $status"
}

command_status() {
  load
  if [ $# -eq 1 ]; then cat "$(task_file "$1")"; return; fi

  local file task status last name
  printf '%-24s %-16s %-8s %-8s %s\n' TASK PROJECT STATUS WORKER "LAST UPDATE"
  for file in "$NUMBRONE_HOME"/tasks/*.md; do
    [ -e "$file" ] || continue
    task="$(basename "$file" .md)"; status="$(field "$file" status)"
    [ "$status" = closed ] && continue
    last="$(grep '^- ' "$file" | tail -n1 | cut -c3- | cut -c1-70)"
    printf '%-24s %-16s %-8s %-8s %s\n' "$task" "$(field "$file" project)" "$status" "$(agent_state "worker-$task")" "$last"
  done
  echo
  printf 'managers:'
  for name in $(jq -r 'keys[]' "$NUMBRONE_HOME/projects.json"); do
    printf ' manager-%s=%s' "$name" "$(agent_state "manager-$name")"
  done
  echo
}

# Rework is the best signal there is about how well work goes, so it never travels as a bare
# herdr prompt: it's recorded in the task file and the work log, where stats and dreams find it.
command_send_back() {
  [ $# -eq 2 ] || die 'usage: numbrone send-back <task> "<what to fix>"'
  load
  local task="$1" note="$2" file who project to
  file="$(task_file "$task")"; [ -f "$file" ] || die "no such task: $task"
  project="$(field "$file" project)"; who="$(my_name)"
  case "$who" in
    worker-*)  die "workers report up with numbrone report; send-back goes down" ;;
    manager-*) to="worker-$task" ;;
    *)         to="manager-$project" ;;   # the chief, or the user from a shell
  esac

  set_field "$file" status working
  log_line "$file" "$who" "sent back: $note"
  if [ "$to" = "worker-$task" ]; then
    herdr agent prompt "$to" "[numbrone] $task sent back by $who: $note. Fix it, commit, and report review again." >/dev/null 2>&1 ||
      die "recorded, but $to isn't running. Start it again with: numbrone spawn $task"
  else
    [ "$(agent_state "$to")" != "-" ] || command_up "$project"
    herdr agent prompt "$to" "[numbrone] $task sent back by $who: $note. Pass it to the worker (numbrone send-back $task \"...\"; numbrone spawn $task if its tab is gone), or handle it yourself." >/dev/null 2>&1 ||
      die "recorded, but $to did not accept the message. See: herdr agent read $to"
  fi
  echo "sent $task back to $to"
}

command_close() {
  [ $# -ge 1 ] && [ $# -le 3 ] || die 'usage: numbrone close <task> <accepted|changed|dropped> ["<note>"]'
  load
  local task="$1" verdict="${2:-}" note="${3:-}" file project path worktree tab branch text
  file="$(task_file "$task")"; [ -f "$file" ] || die "no such task: $task"
  # The verdict is how the dreams learn whether work was any good, whatever kind of work it was.
  case "$verdict" in
    accepted) ;;
    changed|dropped) [ -n "$note" ] || die "say what the user changed, or why it was dropped: numbrone close $task $verdict \"<note>\"" ;;
    "") echo "numbrone: closing without a verdict; next time use: numbrone close $task <accepted|changed|dropped> [\"<note>\"]" >&2 ;;
    *) die "verdict must be accepted, changed or dropped" ;;
  esac
  project="$(field "$file" project)"; path="$(project_path "$project")"; worktree="$(field "$file" worktree)"

  # Refuse to throw away uncommitted work.
  if [ -n "$worktree" ] && [ -d "$worktree" ] && [ -n "$(git -C "$worktree" status --porcelain)" ]; then
    die "$worktree has uncommitted changes; commit or discard them first"
  fi
  tab="$(herdr agent get "worker-$task" 2>/dev/null | jq -r '.result.agent.tab_id')" || tab=""
  [ -n "$tab" ] && herdr tab close "$tab" >/dev/null
  [ -n "$worktree" ] && [ -d "$worktree" ] && git -C "$path" worktree remove "$worktree"

  set_field "$file" status closed
  branch="$(field "$file" branch)"
  text="closed${verdict:+: $verdict}${note:+: $note}"
  log_line "$file" "$(my_name)" "$text${branch:+ (branch $branch kept)}"
  echo "closed $task"
}

command_log() {
  load
  local day="${1:-$(date +%F)}"
  if [ $# -eq 0 ] || [[ "$1" =~ ^[0-9]{4}-[0-9]{2}-[0-9]{2}$ ]]; then
    cat "$NUMBRONE_HOME/log/$day.md" 2>/dev/null || echo "nothing logged on $day"
  else journal "$(my_name)" "$*"; fi
}

# ── learning ───────────────────────────────────────────────────────────────

# The branch work is merged into: BASE_BRANCH, else origin's default branch, else main or master.
base_branch() { # <project path>
  if [ -n "$BASE_BRANCH" ]; then echo "$BASE_BRANCH"; return; fi
  git -C "$1" symbolic-ref --quiet --short refs/remotes/origin/HEAD 2>/dev/null && return
  local name
  for name in main master; do
    git -C "$1" show-ref --verify --quiet "refs/heads/$name" && { echo "$name"; return; }
  done
  return 0
}

# One task's numbers, tab-separated, for any kind of work:
# task project kind status to_deliver to_close sent_back questions escalations verdict edited merged
# - to_deliver: queued → the first time a manager reported review or done
# - to_close:   that delivery → closed
# - questions:  workers' blocked reports (usually the manager answers them)
# - escalations: managers' blocked reports (these reached the user)
# - verdict:    the user's verdict at close: accepted, changed, dropped (or - while open)
# And for work on a branch:
# - edited:     commits on the branch after its last review report: changes made after hand-off
# - merged:     whether the branch is in the base branch (squash merges show as "no")
task_numbers() { # <task file>
  local file="$1" task project status created delivered="" closed="" last_review="" path branch base start
  local sent_back=0 questions=0 escalations=0 edited="-" merged="-" verdict="-" kind when who text
  task="$(basename "$file" .md)"; project="$(field "$file" project)"; status="$(field "$file" status)"
  kind="$(field "$file" kind)"
  created="$(field "$file" created)"
  while read -r _ day time who text; do
    when="$day $time"
    case "$text" in
      review:*) last_review="$when"; [[ -z "$delivered" && "$who" == "[manager-"* ]] && delivered="$when" ;;
      done:*)   [[ -z "$delivered" && "$who" == "[manager-"* ]] && delivered="$when" ;;
      "sent back:"*) sent_back=$(( sent_back + 1 )) ;;
      blocked:*) if [[ "$who" == "[worker-"* ]]; then questions=$(( questions + 1 )); else escalations=$(( escalations + 1 )); fi ;;
      closed*)  closed="$when"
                [[ "$text" =~ ^closed:\ (accepted|changed|dropped) ]] && verdict="${BASH_REMATCH[1]}" ;;
    esac
  done < <(sed -n '/^## Log/,$p' "$file" | grep '^- ')

  path="$(project_path "$project")"; branch="$(field "$file" branch)"
  if [ -n "$path" ] && [ -n "$branch" ] && git -C "$path" show-ref --verify --quiet "refs/heads/$branch"; then
    base="$(base_branch "$path")"
    # Only the task's own commits: from where it started (older task files: where it left the base).
    start="$(field "$file" start)"
    [ -n "$start" ] || start="$([ -n "$base" ] && git -C "$path" merge-base "$base" "$branch" 2>/dev/null)" || start=""
    if [ -n "$last_review" ]; then
      edited="$(git -C "$path" log --format=%ct "${start:+$start..}$branch" 2>/dev/null |
        awk -v after="$(( $(epoch "$last_review") + 60 ))" '$1 >= after { n++ } END { print n + 0 }')"
    fi
    if [ -n "$base" ]; then
      if git -C "$path" merge-base --is-ancestor "$branch" "$base" 2>/dev/null; then merged=yes; else merged=no; fi
    fi
  fi

  printf '%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\n' "$task" "$project" "${kind:--}" "$status" \
    "$([ -n "$delivered" ] && echo $(( $(epoch "$delivered") - $(epoch "$created") )) || echo -)" \
    "$([ -n "$delivered" ] && [ -n "$closed" ] && echo $(( $(epoch "$closed") - $(epoch "$delivered") )) || echo -)" \
    "$sent_back" "$questions" "$escalations" "$verdict" "$edited" "$merged"
}

command_stats() {
  load
  local days="${1:-7}" since file rows
  [[ "$days" =~ ^[0-9]+$ ]] || die "usage: numbrone stats [days]"
  since="$(days_ago "$days")"
  rows="$(for file in "$NUMBRONE_HOME"/tasks/*.md; do
    [ -e "$file" ] || continue
    [[ "$(field "$file" created)" < "$since" ]] && continue
    task_numbers "$file"
  done)"
  [ -n "$rows" ] || { echo "no tasks created since $since"; return; }

  # EDITED and MERGED only apply to work on a branch; they show "-" for everything else.
  printf '%-24s %-14s %-10s %-8s %-10s %-9s %-5s %-5s %-4s %-9s %-7s %s\n' \
    TASK PROJECT KIND STATUS DELIVERED CLOSED BACK ASKED ESC VERDICT EDITED MERGED
  while IFS=$'\t' read -r task project kind status to_deliver to_close back asked escalated verdict edited merged; do
    printf '%-24s %-14s %-10s %-8s %-10s %-9s %-5s %-5s %-4s %-9s %-7s %s\n' "$task" "$project" "$kind" "$status" \
      "$([ "$to_deliver" = - ] && echo - || duration "$to_deliver")" \
      "$([ "$to_close" = - ] && echo - || duration "$to_close")" "$back" "$asked" "$escalated" "$verdict" "$edited" "$merged"
  done <<< "$rows"

  echo
  echo "$rows" | awk -F'\t' -v since="$since" '
    { tasks++; back += $7; asked += $8; escalated += $9; verdicts[$10]++ }
    $5 != "-" {
      delivered++; times[delivered] = $5; if ($7 == 0) first_time++
      if (!($3 in kind_delivered)) kinds[++kind_count] = $3
      kind_delivered[$3]++; if ($7 == 0) kind_first[$3]++
    }
    $11 != "-" && $11 > 0 { edited++ }
    $12 == "yes" { merged++ }
    END {
      median = "-"
      if (delivered) {
        for (i = 1; i <= delivered; i++) for (j = i + 1; j <= delivered; j++)
          if (times[j] < times[i]) { t = times[i]; times[i] = times[j]; times[j] = t }
        m = int(times[int((delivered + 1) / 2)] / 60)
        median = m < 60 ? m "m" : sprintf("%dh%02dm", m / 60, m % 60)
      }
      printf "since %s: %d tasks, %d delivered, %d first time (%d%%), median time to deliver %s\n",
        since, tasks, delivered, first_time, delivered ? 100 * first_time / delivered : 0, median
      printf "send-backs: %d, worker questions: %d, escalations to the user: %d\n", back, asked, escalated
      printf "verdicts: %d accepted, %d changed, %d dropped, %d without one\n",
        verdicts["accepted"], verdicts["changed"], verdicts["dropped"], verdicts["-"]
      if (kind_count) {
        line = "by kind (first time / delivered):"
        for (i = 1; i <= kind_count; i++)
          line = line sprintf("%s %s %d/%d", i > 1 ? "," : "", kinds[i] == "-" ? "untagged" : kinds[i], kind_first[kinds[i]], kind_delivered[kinds[i]])
        print line
      }
      if (edited || merged) printf "branches: %d changed after hand-off, %d merged\n", edited, merged
    }'
}

# The dream: once a day, a short-lived "dreamer" agent reads what happened (the work log, the
# task files, the numbers), writes log/dreams/<date>.md, keeps the lessons files up to date, and
# brings bigger changes to the chief as proposals. Safe to call as often as you like: it dreams
# at most once per day, not before DREAM_HOUR, and only when something happened since last time.
command_dream() {
  load
  if [ "${1:-}" = done ]; then
    [ $# -eq 2 ] || die 'usage: numbrone dream done "<summary>"'
    dream_done "$2"; return
  fi
  [ $# -eq 0 ] || [ "$1" = --force ] || die 'usage: numbrone dream [--force]'

  local dreams="$NUMBRONE_HOME/log/dreams" marker state previous workspace pane
  marker="$dreams/.last"; mkdir -p "$dreams"
  state="$(agent_state dreamer)"
  case "$state" in working|blocked) echo "a dream is already running (herdr tab 'dream')"; return ;; esac

  if [ "${1:-}" != --force ]; then
    [ "$(cat "$marker" 2>/dev/null)" != "$(date +%F)" ] || { echo "already dreamed today"; return; }
    [ "$((10#$(date +%H)))" -ge "$DREAM_HOUR" ] || { echo "not dreaming before $DREAM_HOUR:00"; return; }
    if [ -f "$marker" ]; then
      [ -n "$(find "$NUMBRONE_HOME/log" "$NUMBRONE_HOME/tasks" -maxdepth 1 -name '*.md' -newer "$marker" | head -n1)" ] ||
        { echo "nothing new since the last dream"; return; }
    else
      [ -n "$(find "$NUMBRONE_HOME/log" -maxdepth 1 -name '*.md' | head -n1)" ] || { echo "nothing to dream about yet"; return; }
    fi
  fi

  # The last dreamer's tab stays open so you can read it. Close it now that it's finished.
  if [ "$state" != "-" ]; then
    herdr tab close "$(herdr agent get dreamer | jq -r '.result.agent.tab_id')" >/dev/null 2>&1 || true
  fi

  # Dream next to the chief, or next to whoever asked, or in a workspace of its own.
  workspace="$(herdr agent get chief 2>/dev/null | jq -r '.result.agent.workspace_id // empty')" || workspace=""
  if [ -z "$workspace" ] && [ -n "${HERDR_PANE_ID:-}" ]; then
    workspace="$(herdr pane get "$HERDR_PANE_ID" | jq -r '.result.pane.workspace_id // empty')"
  fi
  if [ -n "$workspace" ]; then
    pane="$(herdr tab create --workspace "$workspace" --cwd "$NUMBRONE_HOME" --label dream --no-focus | jq -r '.result.root_pane.pane_id')"
  else
    pane="$(herdr workspace create --cwd "$NUMBRONE_HOME" --label numbrone --no-focus | jq -r '.result.root_pane.pane_id')"
  fi

  previous="$(find "$dreams" -name '*.md' | sort | tail -n1)"
  if ! (start_agent dreamer "$pane" \
      "You are the dreamer. Today is $(date +%F). The previous dream is ${previous:-none (this is the first)}. Read $NUMBRONE_HOME/roles/dream.md and follow it."); then
    herdr tab close "$(herdr pane get "$pane" | jq -r '.result.pane.tab_id')" >/dev/null 2>&1 || true
    exit 1
  fi
  date +%F > "$marker"
  echo "dreaming in herdr tab 'dream'; it writes $dreams/$(date +%F).md"
}

dream_done() { # <summary>
  local file="log/dreams/$(date +%F).md"
  journal "$(my_name)" "dream: $1 ($file)"
  date +%F > "$NUMBRONE_HOME/log/dreams/.last"   # after the journal line, so it doesn't count as news
  if [ "$PING_CHIEF" = 1 ]; then
    herdr agent prompt chief "[numbrone] dream ready: $NUMBRONE_HOME/$file. $1" >/dev/null 2>&1 || true
  fi
  herdr notification show "Dream ready" --body "$1" --sound done >/dev/null 2>&1 || true
  echo "dream recorded"
}

# ── dispatch ───────────────────────────────────────────────────────────────

command="${1:-help}"; shift || true
case "$command" in
  init|add|remove|projects|up|chief|delegate|spawn|report|status|close|log|stats|dream) "command_$command" "$@" ;;
  send-back) command_send_back "$@" ;;
  help|-h|--help) usage ;;
  *) usage; exit 2 ;;
esac
